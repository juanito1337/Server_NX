# Normalize text in Git; retain Windows-friendly PowerShell / command files.
* text=auto
.gitignore text eol=lf
.gitattributes text eol=lf
*.md text eol=lf
*.py text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
Dockerfile text eol=lf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
